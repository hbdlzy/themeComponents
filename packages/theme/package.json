{
  "name": "@hebang/theme",
  "version": "0.1.0",
  "description": "合邦 Element Plus 主题适配包：SCSS 源码 + 编译后 CSS 双输出",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style": "./dist/index.css",
    "./scss": "./dist/scss/variables.scss",
    "./scss/*": "./dist/scss/*"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "build": "vite build && node scripts/copy-scss.mjs && node scripts/generate-css.mjs && node ../../scripts/copy-cjs-types.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "element-plus": ">=2.7.0"
  },
  "dependencies": {
    "@hebang/tokens": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.5.0"
  }
}

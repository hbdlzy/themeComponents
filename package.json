{
  "name": "theme-components-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "合邦企业主题包 + Element Plus 二次封装组件库 monorepo",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=18.18.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "build:tokens": "pnpm --filter @hebang/tokens run build",
    "build:theme": "pnpm --filter @hebang/theme run build",
    "build:components": "pnpm --filter @hebang/components run build",
    "typecheck": "pnpm -r run typecheck",
    "dev": "pnpm --filter playground run dev",
    "dev:build": "pnpm --filter playground run build",
    "check:publint": "pnpm -r --filter \"./packages/*\" exec npx --yes publint@latest",
    "check:attw": "pnpm -r --filter \"./packages/*\" exec npx --yes @arethetypeswrong/cli --pack . --format table-flipped",
    "pack": "pnpm -r --filter \"./packages/*\" exec pnpm pack",
    "clean": "pnpm -r --filter \"./packages/*\" exec rm -rf dist"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  }
}

# 默认使用公网 npm registry
registry=https://registry.npmjs.org/

# 发布到公司私有 registry 时启用（scope 与包名保持一致）：
# @hebang:registry=https://npm.internal.hebang.com/
# //npm.internal.hebang.com/:_authToken=${NPM_TOKEN}

# workspace 依赖发布时自动替换为真实版本号
save-workspace-protocol=rolling

# peer 依赖版本不匹配时只警告不失败，便于本地调试
strict-peer-dependencies=false
